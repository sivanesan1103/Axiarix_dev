# ─────────────────────────────────────────────────────────────
# Axiarix – environment variables (copy to backend/.env)
# Never commit real secrets. Generate strong random values for production.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050                         # 5000 is taken by macOS AirPlay; documented change
DATABASE_URL=postgresql://axiarix:CHANGE_ME@localhost:5433/axiarix?schema=public
FRONTEND_ORIGIN=http://localhost:5173

# Secrets – at least 32 characters each (MFA key exactly 32)
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_string_______
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_random_string_______
DOWNLOAD_TOKEN_SECRET=CHANGE_ME_min_32_chars_random_string____
MFA_ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT=30               # login / reset attempts per 15 min per IP
API_RATE_LIMIT=600               # API requests per minute per client address
# TRUST_PROXY=2                  # reverse proxies in front of the API (load balancer + nginx); default 1 in production

# Private evidence & report storage (S3-compatible). STORAGE_DRIVER=local for a private disk folder.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9002 # omit for AWS S3
S3_REGION=us-east-1
S3_BUCKET=axiarix-private
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./storage

# Malware scanning: builtin (EICAR/executable heuristics) or clamav (clamd INSTREAM)
MALWARE_SCANNER=builtin
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# SMTP notifications (Mailpit in development: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Axiarix Compliance <no-reply@axiarix.local>"

# Must be true behind HTTPS in production
COOKIE_SECURE=false
